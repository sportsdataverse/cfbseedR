# DESCRIPTION carries no Date field, so fall back to the build year.
year <- if (!is.null(meta$Date)) sub("-.*", "", meta$Date) else format(Sys.Date(), "%Y")
note <- sprintf("R package version %s", meta$Version)

bibentry(
  bibtype  = "Misc",
  header   = "To cite the cfbseedR R package in publications, use:",
  key      = "gilani_cfbseedR",
  # All three DESCRIPTION `aut` entries. Carl and Sharpe are credited
  # because cfbseedR is a direct adaptation of their nflseedR design, which
  # is exactly why DESCRIPTION lists them as authors rather than ctb.
  author   = c(
    person("Saiem", "Gilani", comment = c(ORCID = "0000-0002-7194-9067")),
    person("Sebastian", "Carl"),
    person("Lee", "Sharpe")
  ),
  title    = "cfbseedR: The SportsDataverse's R Package to Simulate and Evaluate College Football Seasons.",
  url      = "https://cfbseedR.sportsdataverse.org/",
  year     = year,
  note     = note,
  textVersion = paste0(
    "Saiem Gilani, Sebastian Carl, and Lee Sharpe (", year, "). cfbseedR: ",
    "The SportsDataverse's R Package ",
    "to Simulate and Evaluate College Football Seasons. ", note,
    ". Retrieved from https://cfbseedR.sportsdataverse.org/"
  ),
  footer = paste(
    "cfbseedR adapts the season-simulation methodology of nflseedR by",
    "Sebastian Carl and Lee Sharpe. If you use that methodology, please",
    "also cite nflseedR: https://nflseedr.com"
  )
)
